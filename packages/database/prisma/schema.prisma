generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  SELLER

  @@map("rol")
}

/// Usuarios internos del panel de gestión (no clientes/checkout público, eso es otra fase).
model Usuario {
  id              String         @id @default(uuid()) @db.Uuid
  nombre          String
  email           String         @unique
  passwordHash    String         @map("password_hash")
  rol             Rol
  activo          Boolean        @default(true)
  ultimoLogin     DateTime?      @map("ultimo_login")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  refreshTokens   RefreshToken[]
  clientesCreados Cliente[]

  proformasCreadas  Proforma[] @relation("ProformaCreadaPor")
  proformaHistorial ProformaHistorial[]

  movimientosCartera MovimientoCartera[]
  traspasosCreados   Traspaso[]
  traspasosAlmacenCreados TraspasoAlmacen[]

  @@map("usuarios")
}

/// Un registro por refresh token emitido; se revoca (nunca se borra) al rotar o al hacer logout.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiraEn  DateTime @map("expira_en")
  revocado  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

enum TipoCliente {
  NATURAL
  JURIDICA

  @@map("tipo_cliente")
}

enum TipoDocumento {
  DNI
  CI
  RUC
  PASAPORTE
  OTRO

  @@map("tipo_documento")
}

/// MANUAL: cargado desde gestión (ADMIN/SELLER). WEB: registro propio del cliente — todavía no
/// implementado, pero el campo ya existe para no requerir otra migración cuando se agregue.
enum OrigenCliente {
  MANUAL
  WEB

  @@map("origen_cliente")
}

/// Clientes del catálogo. Hoy se cargan manualmente desde gestión; el modelo ya queda listo para
/// que más adelante se registren solos desde la web pública (origen = WEB) y para relacionarse con
/// un futuro módulo de Proformas (todavía no existe: sin referencias a eso acá).
model Cliente {
  id              String        @id @default(uuid()) @db.Uuid
  tipo            TipoCliente   @default(NATURAL)
  nombre          String
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @unique @map("numero_documento")
  email           String?       @unique
  telefono        String?
  direccion       String?
  ciudad          String?

  // Referencia a la nueva tabla Ciudad (para Proformas/reparto). No reemplaza el campo `ciudad` de
  // arriba (texto libre, usado por las pantallas de gestión existentes) — conviven, este es opcional
  // y no se retro-completa.
  ciudadId  String? @map("ciudad_id") @db.Uuid
  ciudadRef Ciudad? @relation(fields: [ciudadId], references: [id], onDelete: Restrict)

  origen      OrigenCliente @default(MANUAL)
  creadoPorId String?       @map("creado_por_id") @db.Uuid
  creadoPor   Usuario?      @relation(fields: [creadoPorId], references: [id])

  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proformas Proforma[]

  @@map("clientes")
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT

  @@map("attribute_type")
}

enum AttributeVariantMode {
  /// Atributo normal: un solo valor por producto (comportamiento de siempre).
  NONE
  /// Ej: sabores de un vape. El producto puede tener 1 o más valores y no afecta el precio.
  MULTI_VALUE
  /// Ej: tamaño de un perfume. Cada valor elegido genera una variante con su propio
  /// precio de compra/utilidad/precio $ (y su propio ID de producto).
  PRICED_VARIANT

  @@map("attribute_variant_mode")
}

enum UnidadVariante {
  /// Unidad entera (pieza/botella) — comportamiento de siempre, stock y ventas en unidades.
  PZA
  /// La variante se compra/vende en mililitros — su stock representa ml, no unidades, y admite
  /// subvariantes (PresentacionVenta) para venta fraccionada. Se fija al crear la variante y es
  /// inmutable después (ver doc-comment de ProductVariant.unidad).
  ML

  @@map("unidad_variante")
}

/// Fila única de configuración global del sistema (id fijo "default"). Por ahora solo guarda el
/// tipo de cambio $ -> Bs usado para calcular los precios en bolívares de los productos.
model SystemSetting {
  id           String   @id @default("default")
  exchangeRate Decimal  @default(0) @map("exchange_rate") @db.Decimal(12, 4)
  // Imágenes de las secciones "Propuesta de valor" y "Sobre nosotros" del home — sin esto, esas
  // secciones muestran un placeholder con gradiente (ver Grid Imágenes en Configuración).
  valueImageUrl String? @map("value_image_url")
  aboutImageUrl String? @map("about_image_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryToParent")

  // Costos heredados por los productos de esta subcategoría (solo aplican a subcategorías, no a categorías raíz).
  logisticsCost Decimal? @map("logistics_cost") @db.Decimal(12, 2)
  shippingCost  Decimal? @map("shipping_cost") @db.Decimal(12, 2)
  securityCost  Decimal? @map("security_cost") @db.Decimal(12, 2)

  // Nota interna libre — solo aplica a categorías raíz (sin padre), simétrico al criterio inverso de
  // los costos de arriba.
  comentario String?

  // Orden manual de presentación — solo aplica a categorías raíz: define en qué orden aparecen sus
  // bloques en la página de Home (menor primero). Las subcategorías quedan siempre en 0 y se ordenan
  // por nombre (ver CategoryService.findAll).
  orden Int @default(0)

  brands     BrandCategory[]
  attributes Attribute[]
  products   Product[]
  // Carrusel de imágenes destacadas — solo aplica a categorías raíz, lo usa la sección "Producto
  // destacado" del home (ver Grid Imágenes en Configuración). Sin ninguna cargada, esa sección
  // muestra un placeholder con gradiente y el nombre de la categoría.
  carouselImages CarouselImage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

/// Una imagen dentro de un carrusel del home: del Hero (categoryId null, singleton — no hay más de
/// un Hero) o del bloque "Producto destacado" de una categoría raíz puntual (categoryId). `orden`
/// define el orden de reproducción; se reordena intercambiando `orden` con el vecino (ver
/// CarouselImageService.move), nunca reescribiendo toda la lista.
/** FEATURE: con categoryId de una categoría raíz, el bloque "Producto destacado" del home (tamaño
 * cuadrado); con categoryId null, el Hero principal del home (tamaño panorámico) — es el valor por
 * default histórico, así que sigue significando "el carrusel principal de ese slot".
 * CATEGORY_HERO: carrusel del hero de /categoria/[id] (categoría raíz), tamaño panorámico — se
 * muestra tanto en la página de esa raíz como en la de todas sus subcategorías, pero es un set de
 * imágenes propio, independiente del de FEATURE.
 * MARCAS_HERO: carrusel del hero de /marcas (categoryId null, singleton, tamaño panorámico) —
 * independiente del Hero principal del home.
 * OFFERS_BANNER: carrusel promocional del home (categoryId null, singleton) que ocupa el 5to lugar
 * de la fila de "Descuento y Ofertas" — mismo tamaño que una tarjeta de producto (aspect-ratio 4/5),
 * independiente de los demás. */
enum CarouselKind {
  FEATURE
  CATEGORY_HERO
  MARCAS_HERO
  OFFERS_BANNER
}

model CarouselImage {
  id         String       @id @default(uuid()) @db.Uuid
  categoryId String?      @map("category_id") @db.Uuid
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  kind       CarouselKind @default(FEATURE)
  imageUrl   String       @map("image_url")
  // Link opcional: si tiene valor, la imagen se muestra clickeable en el sitio público y redirige
  // ahí; si está vacío, la imagen queda decorativa (sin click), como era antes de este campo.
  url        String?
  orden      Int          @default(0)
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([categoryId, kind, orden])
  @@map("carousel_images")
}

model Brand {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  slug    String  @unique
  logoUrl String? @map("logo_url")

  categories BrandCategory[]
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brands")
}

model BrandCategory {
  brandId    String   @map("brand_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([brandId, categoryId])
  @@map("brand_categories")
}

model Attribute {
  id                String               @id @default(uuid()) @db.Uuid
  categoryId        String               @map("category_id") @db.Uuid
  category          Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  type              AttributeType
  isFilterable      Boolean              @default(false) @map("is_filterable")
  isRequired        Boolean              @default(false) @map("is_required")
  // Si se muestra como columna extra en la tabla de Productos del panel (además de las de siempre).
  showInProductList Boolean              @default(false) @map("show_in_product_list")
  // Si se muestra al armar una línea de proforma (VarianteSelector/AtributosVisibles), ordenado por `orden`.
  mostrarEnProforma Boolean              @default(false) @map("mostrar_en_proforma")
  orden             Int                  @default(0)
  // Solo aplica (y solo tiene sentido) cuando type = SELECT.
  variantMode       AttributeVariantMode @default(NONE) @map("variant_mode")
  // Solo aplica cuando type = SELECT y variantMode = NONE: el producto puede elegir 1+ opciones de
  // la lista compartida de la categoría (ej. Acordes de un perfume), a diferencia de MULTI_VALUE
  // (valores propios por producto, para variantes tipo sabor).
  allowMultiple     Boolean              @default(false) @map("allow_multiple")

  options             AttributeOption[]
  productValues       ProductAttributeValue[]
  variantOptionValues ProductVariantOptionValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, name])
  @@map("attributes")
}

model AttributeOption {
  id          String    @id @default(uuid()) @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  // Color hex (ej. "#c9a96e") para el botón de esta opción en el formulario de producto. Opcional.
  color       String?

  productValues ProductAttributeValue[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([attributeId, value])
  @@map("attribute_options")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  productCode   String   @unique @map("product_code") @db.VarChar(7)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  // Utilidad cargada manualmente; ni los 3 costos heredados ni el precio final se guardan acá:
  // el precio $ se calcula en vivo como purchasePrice + costos de `category` + utility.
  utility       Decimal  @default(0) @map("utility") @db.Decimal(12, 2)
  // Precios en bolívares. Precio May Bs (mayorista) se calcula en vivo (precio $ * tipo de cambio
  // del sistema); "Add May" (este campo, minPriceBs — el nombre no cambió, solo su significado) y
  // Descuento se cargan a mano; Precio Final Bs = (Precio May Bs + Add May) - Descuento. Si la
  // categoría tiene variantes con precio propio, estos dos campos manuales se cargan por variante en
  // lugar de acá (mismo criterio que purchasePrice/utility).
  minPriceBs    Decimal? @map("min_price_bs") @db.Decimal(12, 2)
  discountBs    Decimal  @default(0) @map("discount_bs") @db.Decimal(12, 2)
  brandId       String?  @map("brand_id") @db.Uuid
  brand         Brand?   @relation(fields: [brandId], references: [id])
  categoryId    String   @map("category_id") @db.Uuid
  category      Category @relation(fields: [categoryId], references: [id])
  imageUrl      String?  @map("image_url")

  attributeValues     ProductAttributeValue[]
  variantOptionValues ProductVariantOptionValue[]
  variants            ProductVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Sin esto, cualquier filtro por categoría (raíz, subcategoría) o marca hace un sequential scan de
  // toda la tabla — se nota cada vez más a medida que crece el catálogo.
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductAttributeValue {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  valueText    String?          @map("value_text")
  valueNumber  Decimal?         @map("value_number") @db.Decimal(14, 4)
  valueBoolean Boolean?         @map("value_boolean")
  optionId     String?          @map("option_id") @db.Uuid
  option       AttributeOption? @relation(fields: [optionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un atributo MULTI_VALUE puede tener varias filas (una por opción elegida) para el mismo
  // producto; para atributos normales el servicio valida que solo exista una fila.
  @@unique([productId, attributeId, optionId])
  @@map("product_attribute_values")
}

/// Variante con precio propio de un producto (ej. "50ml" de un perfume): tiene su propio
/// código de producto, precio de compra y utilidad. Se define por una combinación de 1 o más
/// opciones de atributos PRICED_VARIANT de la categoría del producto.
model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantCode   String   @unique @map("variant_code") @db.VarChar(7)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  utility       Decimal  @default(0) @map("utility") @db.Decimal(12, 2)
  // Mismo criterio que en Product: "Add May" (este campo) y Descuento propios de esta variante.
  minPriceBs    Decimal? @map("min_price_bs") @db.Decimal(12, 2)
  discountBs    Decimal  @default(0) @map("discount_bs") @db.Decimal(12, 2)

  // Marca la única variante auto-provista para productos cuya categoría no tiene ningún atributo
  // PRICED_VARIANT (así Stock/Proformas siempre tienen un varianteId consistente al que atarse,
  // incluso para productos "simples"). Nunca se crea ni se borra a mano — la administra
  // product.service.ts (ensureDefaultVariant). Copia purchasePrice/utility/minPriceBs/discountBs del
  // Product al crearse; no se mantiene sincronizada después (el producto sigue siendo la fuente de
  // verdad para catálogo simple).
  isDefault Boolean @default(false) @map("is_default")

  // Se fija al crear la variante; inmutable después (product.service.ts nunca lo aplica en update,
  // para no corromper el significado de stock ya cargado). PZA = de siempre. ML = esta variante no
  // se vende directo (ej. "Fraccionado" de un perfume): su stock son ml sueltos, comprados por lote
  // como cualquier otra variante (cantidad = ml), y vendidos únicamente a través de sus
  // PresentacionVenta (subvariantes con precio propio, ej. decants de 5/10/30 ml) — ver
  // PresentacionVenta y addDetalleVenta en proformas.service.ts.
  unidad UnidadVariante @default(PZA) @map("unidad")

  // Imagen propia de esta variante puntual, para distinguirla a simple vista de las demás del mismo
  // producto — solo aplica a variantes unidad=PZA (product.service.ts lo valida). Si no tiene, los
  // listados caen al Product.imageUrl genérico.
  imageUrl String? @map("image_url")

  // Control de catálogo (todavía no lo consume ningún flujo automático — punto de extensión para
  // filtrar el catálogo público más adelante). Aplica a cualquier variante, PZA o ML.
  disponible Boolean @default(true)

  options        ProductVariantOption[]
  presentaciones PresentacionVenta[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock            Stock[]
  lotesCompra      LoteCompra[]
  proformaDetalles ProformaDetalle[]
  traspasosAlmacen TraspasoAlmacen[]

  @@map("product_variants")
}

/// Valor propio de un producto para un atributo MULTI_VALUE o PRICED_VARIANT (ej. "Menta" para el
/// Sabor de este vape puntual, "50 ML" para el Tamaño de este perfume puntual). A diferencia de
/// AttributeOption (compartido a nivel de categoría, solo para atributos NONE), estos valores no se
/// comparten entre productos: cada producto arma su propia lista.
model ProductVariantOptionValue {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  // Poblado solo si attribute.variantMode = PRICED_VARIANT (una variante referencia 1 de estos
  // valores por cada atributo con precio propio de la categoría).
  variantOptions ProductVariantOption[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, attributeId, value], map: "product_variant_option_values_unique")
  @@map("product_variant_option_values")
}

model ProductVariantOption {
  id            String                    @id @default(uuid()) @db.Uuid
  variantId     String                    @map("variant_id") @db.Uuid
  variant       ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String                    @map("option_value_id") @db.Uuid
  optionValue   ProductVariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@map("product_variant_options")
}

/// Subvariante con precio propio de una ProductVariant con unidad = ML (ej. los decants de 5/10/30 ml
/// de la variante "Fraccionado" de un perfume) — mismo espíritu que ProductVariant/Attribute
/// PRICED_VARIANT pero un escalón más abajo: en vez de combinaciones de atributos, es un catálogo
/// fijo por variante padre, con un precio de venta manual (el costo ya está cubierto por la compra
/// de la variante padre, no necesita su propio purchasePrice/utility). Vender N unidades de una
/// subvariante resuelve cantidad = N * cantidadMl y precioUnitario = precioVentaBs / cantidadMl
/// antes de crear el ProformaDetalle (ver addDetalleVenta en proformas.service.ts) — desde ahí en
/// adelante es una línea más para el motor genérico de Stock, y descuenta únicamente del stock de
/// la variante padre (nunca del de las variantes de Tamaño). Solo tiene sentido para variantes con
/// unidad = ML.
model PresentacionVenta {
  id            String         @id @default(uuid()) @db.Uuid
  varianteId    String         @map("variante_id") @db.Uuid
  variante      ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  cantidadMl    Int            @map("cantidad_ml")
  precioVentaBs Decimal        @db.Decimal(12, 2) @map("precio_venta_bs")
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  proformaDetalles ProformaDetalle[]

  @@unique([varianteId, cantidadMl])
  @@map("presentaciones_venta")
}

// ─────────────────────────────────────────────────────────────────────────────
// Proformas: empresas, almacenes, stock, lotes de compra y proformas de compra/venta.
// ─────────────────────────────────────────────────────────────────────────────

enum TipoEmpresa {
  CASA_MATRIZ
  SUCURSAL

  @@map("tipo_empresa")
}

enum TipoProforma {
  COMPRA
  VENTA

  @@map("tipo_proforma")
}

/// BORRADOR: recién creada, todo editable, o se elimina directamente. APROBADA: motor de
/// reparto/reserva ya corrió contra el único almacén elegido (VENTA) o lista para completar (COMPRA).
/// COMPLETADA: terminal, efectos de stock/lotes ya aplicados. ANULADA: alcanzable solo desde APROBADA
/// (libera las reservas hechas).
enum EstadoProforma {
  BORRADOR
  APROBADA
  COMPLETADA
  ANULADA

  @@map("estado_proforma")
}

/// STOCK: cubierta con inventario físico de un almacén. PROCURA: remanente sin cobertura (almacenId
/// null), a comprar/procurar aparte.
enum OrigenAsignacion {
  STOCK
  PROCURA

  @@map("origen_asignacion")
}

/// Estado de seguimiento de una línea a Procura (ver ProformaDetalleAsignacion.estadoSeguimiento):
/// PENDIENTE (todavía no se le pidió al proveedor) → COMPRADO (ya se le compró) → ENVIADO (ya está en
/// camino). No es un log histórico como el viejo EstadoSeguimiento de 4 pasos que este reemplaza —
/// es el estado actual de la línea, editable directamente.
enum EstadoSeguimientoProcura {
  PENDIENTE
  COMPRADO
  ENVIADO

  @@map("estado_seguimiento_procura")
}

model Ciudad {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clientes         Cliente[]
  proformasEntrega Proforma[]      @relation("ProformaCiudadEntrega")

  @@map("ciudades")
}

/// Catálogo de países de origen (de dónde viene la mercadería) — usada en Proforma.paisProcedencia
/// (solo COMPRA). Separado de Ciudad (que es la ciudad de ENTREGA del cliente) porque son dos
/// conceptos distintos aunque hoy tengan una forma parecida.
model PaisProcedencia {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proformas   Proforma[]
  proveedores Proveedor[]

  @@map("paises_procedencia")
}

/// Catálogo de proveedores (a quién se le compra) — listado desde el sidebar bajo "Proveedores".
/// paisProcedenciaId es obligatorio a nivel de servicio (nullable acá solo por si en el futuro se
/// permite un proveedor sin país definido); nota es libre, informativa.
model Proveedor {
  id                String           @id @default(uuid()) @db.Uuid
  nombre            String
  paisProcedenciaId String?          @map("pais_procedencia_id") @db.Uuid
  paisProcedencia   PaisProcedencia? @relation(fields: [paisProcedenciaId], references: [id], onDelete: Restrict)
  nota              String?
  activo            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  proformas Proforma[]

  @@map("proveedores")
}

model Empresa {
  id          String      @id @default(uuid()) @db.Uuid
  nombre      String
  tipo        TipoEmpresa
  razonSocial String      @map("razon_social")
  nit         String      @unique
  logoUrl     String?     @map("logo_url")
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  proformas Proforma[]

  @@map("empresas")
}

model Almacen {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock        Stock[]
  lotesCompra  LoteCompra[]
  proformas    Proforma[]                  @relation("ProformaAlmacen")
  asignaciones ProformaDetalleAsignacion[]
  traspasosOrigen  TraspasoAlmacen[] @relation("TraspasoAlmacenOrigen")
  traspasosDestino TraspasoAlmacen[] @relation("TraspasoAlmacenDestino")

  @@map("almacenes")
}

/// Existencias por variante y almacén. cantidadReservada se incrementa al aprobar una venta (aparta
/// stock sin descontarlo todavía) y se descuenta junto con cantidadFisica al completarla.
/// CHECK agregado a mano en la migración: cantidad_fisica >= 0 AND cantidad_reservada >= 0 AND
/// cantidad_reservada <= cantidad_fisica (Prisma no expresa CHECK en el schema).
model Stock {
  varianteId        String         @map("variante_id") @db.Uuid
  variante          ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  almacenId         String         @map("almacen_id") @db.Uuid
  almacen           Almacen        @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  cantidadFisica    Int            @default(0) @map("cantidad_fisica")
  cantidadReservada Int            @default(0) @map("cantidad_reservada")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@id([varianteId, almacenId])
  @@map("stock")
}

/// Un lote por línea de compra completada, con el costo real de esa compra puntual. Nunca se borra
/// ni se modifica al cambiar el catálogo — es el registro histórico que se consume con FIFO al
/// vender, y lo que permite calcular margen real más adelante.
model LoteCompra {
  id                 String          @id @default(uuid()) @db.Uuid
  varianteId         String          @map("variante_id") @db.Uuid
  variante           ProductVariant  @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  almacenId          String          @map("almacen_id") @db.Uuid
  almacen            Almacen         @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  // Ya no es @unique: en el flujo normal (completarCompra) sigue siendo 1 lote por línea, pero una
  // corrección manual de catálogo (ej. repartir un lote entre variantes nuevas tras convertir un
  // atributo MULTI_VALUE a PRICED_VARIANT) necesita poder partir un lote en más de un registro
  // referenciando la misma línea de compra original. Nada en el código consulta por este campo como
  // clave única (verificado), así que aflojar la restricción no cambia ningún comportamiento existente.
  proformaDetalleId  String          @map("proforma_detalle_id") @db.Uuid
  proformaDetalle    ProformaDetalle @relation(fields: [proformaDetalleId], references: [id], onDelete: Restrict)
  costoUnitario      Decimal         @map("costo_unitario") @db.Decimal(12, 2)
  cantidadInicial    Int             @map("cantidad_inicial")
  cantidadDisponible Int             @map("cantidad_disponible")
  fecha              DateTime        @default(now())

  consumos LoteCompraConsumo[]
  traspasosComoOrigen  TraspasoAlmacenLote[] @relation("LoteOrigenTraspaso")
  traspasosComoDestino TraspasoAlmacenLote[] @relation("LoteDestinoTraspaso")

  @@index([varianteId, almacenId, fecha])
  @@index([proformaDetalleId])
  @@map("lotes_compra")
}

/// Registra de qué lote(s) salió cada unidad vendida (consumo FIFO al completar una venta) — la
/// tabla que hace posible calcular margen real más adelante. No está nombrada en el spec original,
/// pero es necesaria para cumplir "registrando de qué lote(s) salió cada unidad vendida".
model LoteCompraConsumo {
  id                          String                    @id @default(uuid()) @db.Uuid
  loteCompraId                String                    @map("lote_compra_id") @db.Uuid
  loteCompra                  LoteCompra                @relation(fields: [loteCompraId], references: [id], onDelete: Restrict)
  proformaDetalleAsignacionId String                    @map("proforma_detalle_asignacion_id") @db.Uuid
  asignacion                  ProformaDetalleAsignacion @relation(fields: [proformaDetalleAsignacionId], references: [id], onDelete: Restrict)
  cantidad                    Int
  createdAt                   DateTime                  @default(now()) @map("created_at")

  @@unique([loteCompraId, proformaDetalleAsignacionId])
  @@map("lotes_compra_consumo")
}

/// Traspaso de stock físico de una variante entre dos almacenes — instantáneo, inmutable (igual
/// criterio que Traspaso de Contabilidad). Descuenta cantidadFisica del origen y la suma al destino,
/// moviendo también el/los LoteCompra usados: por cada lote de origen decrementa su
/// cantidadDisponible y crea un LoteCompra nuevo en el destino con el mismo costoUnitario y el mismo
/// proformaDetalleId (la compra original no cambia, solo dónde está físicamente ese lote ahora) —
/// así una venta futura desde el destino sigue eligiendo lotes reales con costo real. No se puede
/// traspasar stock reservado (cantidadReservada): solo lo disponible (física - reservada).
model TraspasoAlmacen {
  id               String         @id @default(uuid()) @db.Uuid
  fecha            DateTime       @default(now())
  varianteId       String         @map("variante_id") @db.Uuid
  variante         ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  almacenOrigenId  String         @map("almacen_origen_id") @db.Uuid
  almacenOrigen    Almacen        @relation("TraspasoAlmacenOrigen", fields: [almacenOrigenId], references: [id], onDelete: Restrict)
  almacenDestinoId String         @map("almacen_destino_id") @db.Uuid
  almacenDestino   Almacen        @relation("TraspasoAlmacenDestino", fields: [almacenDestinoId], references: [id], onDelete: Restrict)
  cantidad         Int
  nota             String?
  creadoPorId      String         @map("creado_por_id") @db.Uuid
  creadoPor        Usuario        @relation(fields: [creadoPorId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")

  lotes TraspasoAlmacenLote[]

  @@map("traspasos_almacen")
}

/// Detalle de qué lote de origen alimentó qué lote nuevo en destino y cuánto — igual criterio que
/// LoteCompraConsumo para ventas.
model TraspasoAlmacenLote {
  id            String          @id @default(uuid()) @db.Uuid
  traspasoId    String          @map("traspaso_id") @db.Uuid
  traspaso      TraspasoAlmacen @relation(fields: [traspasoId], references: [id], onDelete: Cascade)
  loteOrigenId  String          @map("lote_origen_id") @db.Uuid
  loteOrigen    LoteCompra      @relation("LoteOrigenTraspaso", fields: [loteOrigenId], references: [id], onDelete: Restrict)
  loteDestinoId String          @map("lote_destino_id") @db.Uuid
  loteDestino   LoteCompra      @relation("LoteDestinoTraspaso", fields: [loteDestinoId], references: [id], onDelete: Restrict)
  cantidad      Int

  @@map("traspasos_almacen_lote")
}

model Proforma {
  id     String         @id @default(uuid()) @db.Uuid
  tipo   TipoProforma
  estado EstadoProforma @default(BORRADOR)

  // Código corto para mostrar/buscar en vez del id UUID (mismo mecanismo que Product.productCode /
  // ProductVariant.variantCode — generateUniqueEntityCode, alfanumérico de 7, no lo escribe el
  // usuario). No secuencial a propósito.
  codigo String @unique

  empresaId String  @map("empresa_id") @db.Uuid
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  // Obligatorio si tipo = VENTA, null si tipo = COMPRA (validado en servicio).
  clienteId String?  @map("cliente_id") @db.Uuid
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  // Almacén de la proforma: para VENTA se fija al aprobar (ahí se resuelve el reparto/reserva de
  // stock contra este almacén); para COMPRA se fija recién al completar (a qué almacén entra la
  // mercadería). Null hasta ese momento en ambos casos.
  almacenId String?  @map("almacen_id") @db.Uuid
  almacen   Almacen? @relation("ProformaAlmacen", fields: [almacenId], references: [id], onDelete: Restrict)

  // Solo VENTA: dato informativo de a qué ciudad va el pedido, sin efecto en la lógica de negocio.
  ciudadEntregaId String? @map("ciudad_entrega_id") @db.Uuid
  ciudadEntrega   Ciudad? @relation("ProformaCiudadEntrega", fields: [ciudadEntregaId], references: [id], onDelete: Restrict)

  // Solo COMPRA: a quién se le compra — mismo rol que clienteId cumple en VENTA. Al elegirlo en el
  // formulario de creación, precarga paisProcedenciaId con el país del proveedor (igual criterio que
  // clienteId precarga ciudadEntregaId) — sigue editable después.
  proveedorId String?    @map("proveedor_id") @db.Uuid
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  // Solo COMPRA: de dónde viene la mercadería (informativo) y el tipo de cambio propio de ESTA
  // compra puntual — permite valorar en Bs sin depender del tipo de cambio del sistema, que puede
  // cambiar después de hecha la compra. Ambos null para VENTA.
  paisProcedenciaId String?          @map("pais_procedencia_id") @db.Uuid
  paisProcedencia   PaisProcedencia? @relation(fields: [paisProcedenciaId], references: [id], onDelete: Restrict)
  tipoCambioProf    Decimal?         @map("tipo_cambio_prof") @db.Decimal(12, 4)

  creadoPorId String  @map("creado_por_id") @db.Uuid
  creadoPor   Usuario @relation("ProformaCreadaPor", fields: [creadoPorId], references: [id])

  // Aplica sobre el total del documento, no por línea (no se mezcla con el descuento de catálogo,
  // que ya está incorporado en precioFinalBs de cada línea de venta).
  descuentoGeneral Decimal  @default(0) @map("descuento_general") @db.Decimal(12, 2)
  // Campo informativo por ahora: qué % del total debe adelantar el cliente (el monto y el saldo se
  // calculan en vivo a partir del total de las líneas). Sin ligar a un módulo de pagos todavía
  // (punto de extensión futuro).
  adelantoPorcentaje Decimal? @map("adelanto_porcentaje") @db.Decimal(5, 2)

  fecha     DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  detalles           ProformaDetalle[]
  historial          ProformaHistorial[]
  movimientosCartera MovimientoCartera[]
  // Solo VENTA, y solo si al completar quedó saldo pendiente (> 0) — ver
  // proforma-completion.service.ts. Null si no hubo saldo pendiente (incluye adelanto 100%) o si
  // todavía no se completó.
  cuentaPorCobrar    CuentaPorCobrar?

  @@index([tipo, estado])
  @@map("proformas")
}

model ProformaDetalle {
  id         String         @id @default(uuid()) @db.Uuid
  proformaId String         @map("proforma_id") @db.Uuid
  proforma   Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  varianteId String         @map("variante_id") @db.Uuid
  variante   ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  cantidad   Int

  // VENTA, solo si la variante vendida es unidad=ML: qué PresentacionVenta (subvariante) se eligió.
  // Puramente informativo/auditoría — cantidad y precioUnitario ya vienen resueltos a partir de acá
  // en addDetalleVenta (proformas.service.ts) y de ahí en más el resto del flujo (Stock, Procura,
  // aprobación, completación) no sabe ni le importa que exista una presentación detrás.
  presentacionVentaId String?            @map("presentacion_venta_id") @db.Uuid
  presentacionVenta   PresentacionVenta? @relation(fields: [presentacionVentaId], references: [id], onDelete: Restrict)

  // VENTA: nace de ProductVariant.precioFinalBs (calculado en vivo al agregar la línea) y es editable
  // después.
  precioUnitario Decimal? @map("precio_unitario") @db.Decimal(12, 2)

  // COMPRA: capturados por línea (no heredados del catálogo) — de esta compra puntual. Al completar
  // se usan para armar el LoteCompra; el catálogo (Product/ProductVariant) nunca se sobreescribe con
  // estos valores.
  precioCompra   Decimal? @map("precio_compra") @db.Decimal(12, 2)
  costoEnvio     Decimal? @map("costo_envio") @db.Decimal(12, 2)
  costoSeguridad Decimal? @map("costo_seguridad") @db.Decimal(12, 2)
  costoLogistica Decimal? @map("costo_logistica") @db.Decimal(12, 2)

  // cantidad × precioUnitario (VENTA) o cantidad × suma de los 4 costos (COMPRA). Recalculado en el
  // servicio en cada create/update de la línea.
  subtotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asignaciones ProformaDetalleAsignacion[]
  // 1+ (no 0-o-1): al completar una compra nace 1, pero una corrección manual de catálogo puede
  // partir ese lote en más de un registro (ver comentario en LoteCompra.proformaDetalleId).
  loteCompras LoteCompra[]

  @@map("proforma_detalles")
}

/// Resultado de reservar stock contra el único almacén de la proforma al aprobar una venta: STOCK por
/// lo que alcanzó, PROCURA por el resto (se resuelve solo más adelante, al completar una compra que
/// traiga stock para esa variante+almacén). CHECK agregado a mano en la migración:
/// (origen='PROCURA' AND almacen_id IS NULL) OR (origen='STOCK' AND almacen_id IS NOT NULL).
model ProformaDetalleAsignacion {
  id                String           @id @default(uuid()) @db.Uuid
  proformaDetalleId String           @map("proforma_detalle_id") @db.Uuid
  proformaDetalle   ProformaDetalle  @relation(fields: [proformaDetalleId], references: [id], onDelete: Cascade)
  almacenId         String?          @map("almacen_id") @db.Uuid
  almacen           Almacen?         @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  cantidad          Int
  origen            OrigenAsignacion
  // Solo tiene sentido mientras origen=PROCURA y cantidad>0 (ver módulo Seguimiento) — en filas STOCK
  // queda en el default sin usarse. Estado actual editable, no un log histórico.
  estadoSeguimiento EstadoSeguimientoProcura @default(PENDIENTE) @map("estado_seguimiento")

  createdAt DateTime @default(now()) @map("created_at")

  consumos LoteCompraConsumo[]

  @@map("proforma_detalle_asignaciones")
}

/// Log de solo-inserción de cada cambio de estado de una proforma.
model ProformaHistorial {
  id         String         @id @default(uuid()) @db.Uuid
  proformaId String         @map("proforma_id") @db.Uuid
  proforma   Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  estado     EstadoProforma
  fecha      DateTime       @default(now())
  usuarioId  String         @map("usuario_id") @db.Uuid
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  nota       String?

  @@map("proforma_historial")
}

// --- Financiero (Contabilidad) ---

enum MonedaCartera {
  BS
  USDT
  GS
  CLP
  USD

  @@map("moneda_cartera")
}

enum NaturalezaMovimiento {
  INGRESO
  GASTO

  @@map("naturaleza_movimiento")
}

enum EstadoCuentaPorCobrar {
  PENDIENTE
  COMPLETADO

  @@map("estado_cuenta_por_cobrar")
}

/// Una billetera/caja dentro de una Cuenta (moneda). saldoActual es un acumulador mantenido en cada
/// alta de movimiento/traspaso (transaccional, con locking vía cartera-lock.util.ts) — no se
/// recalcula desde cero en cada lectura, a diferencia del saldo por fila de MovimientoCartera (ver
/// el doc-comment de ese modelo para el porqué).
model Cartera {
  id          String        @id @default(uuid()) @db.Uuid
  moneda      MonedaCartera
  nombre      String
  activo      Boolean       @default(true)
  saldoActual Decimal       @default(0) @db.Decimal(14, 2) @map("saldo_actual")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tiposMovimiento  TipoMovimiento[]
  movimientos      MovimientoCartera[]
  traspasosOrigen  Traspaso[]          @relation("TraspasoOrigen")
  traspasosDestino Traspaso[]          @relation("TraspasoDestino")

  @@unique([moneda, nombre])
  @@map("carteras")
}

/// Categorías de ingreso/gasto, independientes por cartera (no se comparten ni entre carteras de la
/// misma moneda). Soft delete vía activo — un tipo usado en movimientos históricos no se puede borrar
/// de verdad (Restrict), pero se puede ocultar de la lista para cargar movimientos nuevos.
model TipoMovimiento {
  id         String               @id @default(uuid()) @db.Uuid
  carteraId  String               @map("cartera_id") @db.Uuid
  cartera    Cartera              @relation(fields: [carteraId], references: [id], onDelete: Restrict)
  nombre     String
  naturaleza NaturalezaMovimiento
  activo     Boolean              @default(true)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  movimientos MovimientoCartera[]

  @@unique([carteraId, nombre, naturaleza])
  @@map("tipos_movimiento")
}

/// Log de solo-inserción (nunca se edita ni se borra por API) — cada fila es un ingreso o gasto de
/// una cartera. tipoMovimientoId es obligatorio para carga manual; queda null en las 2 filas que
/// genera un Traspaso (esas se identifican por traspasoId en cambio, y su detalle se arma solo) y en
/// las que genera la aprobación/anulación de adelanto de una proforma de venta (identificadas por
/// proformaId, ver proforma-approval.service.ts).
/// fecha siempre es la fecha/hora actual del servidor al momento de crear (no editable desde la
/// API, ni en carga manual ni en traspasos) — coincide con createdAt. El saldo acumulado ("Total"
/// en la UI) no se guarda acá: se recalcula en memoria al leer (movimiento.service.ts), ordenando
/// por fecha — barato a la escala de una caja chica.
model MovimientoCartera {
  id               String               @id @default(uuid()) @db.Uuid
  carteraId        String               @map("cartera_id") @db.Uuid
  cartera          Cartera              @relation(fields: [carteraId], references: [id], onDelete: Restrict)
  fecha            DateTime
  detalle          String
  naturaleza       NaturalezaMovimiento
  monto            Decimal              @db.Decimal(14, 2)
  tipoMovimientoId String?              @map("tipo_movimiento_id") @db.Uuid
  tipoMovimiento   TipoMovimiento?      @relation(fields: [tipoMovimientoId], references: [id], onDelete: Restrict)
  traspasoId       String?              @map("traspaso_id") @db.Uuid
  traspaso         Traspaso?            @relation(fields: [traspasoId], references: [id], onDelete: Restrict)
  proformaId       String?              @map("proforma_id") @db.Uuid
  proforma         Proforma?            @relation(fields: [proformaId], references: [id], onDelete: Restrict)
  creadoPorId      String               @map("creado_por_id") @db.Uuid
  creadoPor        Usuario              @relation(fields: [creadoPorId], references: [id])
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([carteraId, fecha])
  @@index([proformaId])
  @@map("movimientos_cartera")
}

/// Mueve montoOrigen de carteraOrigen a carteraDestino. Si las monedas difieren, tipoCambio es
/// obligatorio y montoDestino = montoOrigen * tipoCambio (se guarda ya calculado, para que quede una
/// constancia histórica estable aunque el tipo de cambio del sistema cambie después). Genera 2
/// MovimientoCartera (GASTO en origen, INGRESO en destino) atómicamente. Inmutable, igual que
/// MovimientoCartera.
model Traspaso {
  id               String   @id @default(uuid()) @db.Uuid
  fecha            DateTime
  carteraOrigenId  String   @map("cartera_origen_id") @db.Uuid
  carteraOrigen    Cartera  @relation("TraspasoOrigen", fields: [carteraOrigenId], references: [id], onDelete: Restrict)
  carteraDestinoId String   @map("cartera_destino_id") @db.Uuid
  carteraDestino   Cartera  @relation("TraspasoDestino", fields: [carteraDestinoId], references: [id], onDelete: Restrict)
  montoOrigen      Decimal  @db.Decimal(14, 2) @map("monto_origen")
  tipoCambio       Decimal  @default(1) @db.Decimal(12, 4) @map("tipo_cambio")
  montoDestino     Decimal  @db.Decimal(14, 2) @map("monto_destino")
  nota             String?
  creadoPorId      String   @map("creado_por_id") @db.Uuid
  creadoPor        Usuario  @relation(fields: [creadoPorId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  movimientos MovimientoCartera[]

  @@map("traspasos")
}

/// Saldo que un cliente todavía debe de una VENTA ya completada (proforma-completion.service.ts crea
/// esta fila cuando, al completar, queda saldo > 0 después de descontar el adelanto ya cobrado — si
/// no queda saldo, no se crea fila). montoAdeudado es un acumulador mantenido en cada cobro
/// (transaccional, mismo criterio que Cartera.saldoActual) — arranca en el saldo pendiente al
/// completar y baja con cada cobro parcial hasta llegar a 0, momento en que estado pasa a
/// COMPLETADO. Cada cobro genera además un MovimientoCartera INGRESO en la cartera Bs elegida (ligado
/// vía proformaId, igual mecanismo que el adelanto).
model CuentaPorCobrar {
  id            String                @id @default(uuid()) @db.Uuid
  proformaId    String                @unique @map("proforma_id") @db.Uuid
  proforma      Proforma              @relation(fields: [proformaId], references: [id], onDelete: Restrict)
  montoAdeudado Decimal               @map("monto_adeudado") @db.Decimal(14, 2)
  estado        EstadoCuentaPorCobrar @default(PENDIENTE)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([estado])
  @@map("cuentas_por_cobrar")
}
