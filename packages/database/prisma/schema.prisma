generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  SELLER

  @@map("rol")
}

/// Usuarios internos del panel de gestión (no clientes/checkout público, eso es otra fase).
model Usuario {
  id              String         @id @default(uuid()) @db.Uuid
  nombre          String
  email           String         @unique
  passwordHash    String         @map("password_hash")
  rol             Rol
  activo          Boolean        @default(true)
  ultimoLogin     DateTime?      @map("ultimo_login")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  refreshTokens   RefreshToken[]
  clientesCreados Cliente[]

  proformasCreadas  Proforma[]                   @relation("ProformaCreadaPor")
  proformaHistorial ProformaHistorial[]
  seguimientos      ProformaDetalleSeguimiento[]

  @@map("usuarios")
}

/// Un registro por refresh token emitido; se revoca (nunca se borra) al rotar o al hacer logout.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiraEn  DateTime @map("expira_en")
  revocado  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

enum TipoCliente {
  NATURAL
  JURIDICA

  @@map("tipo_cliente")
}

enum TipoDocumento {
  DNI
  CI
  RUC
  PASAPORTE
  OTRO

  @@map("tipo_documento")
}

/// MANUAL: cargado desde gestión (ADMIN/SELLER). WEB: registro propio del cliente — todavía no
/// implementado, pero el campo ya existe para no requerir otra migración cuando se agregue.
enum OrigenCliente {
  MANUAL
  WEB

  @@map("origen_cliente")
}

/// Clientes del catálogo. Hoy se cargan manualmente desde gestión; el modelo ya queda listo para
/// que más adelante se registren solos desde la web pública (origen = WEB) y para relacionarse con
/// un futuro módulo de Proformas (todavía no existe: sin referencias a eso acá).
model Cliente {
  id              String        @id @default(uuid()) @db.Uuid
  tipo            TipoCliente   @default(NATURAL)
  nombre          String
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @unique @map("numero_documento")
  email           String?       @unique
  telefono        String?
  direccion       String?
  ciudad          String?

  // Referencia a la nueva tabla Ciudad (para Proformas/reparto). No reemplaza el campo `ciudad` de
  // arriba (texto libre, usado por las pantallas de gestión existentes) — conviven, este es opcional
  // y no se retro-completa.
  ciudadId  String? @map("ciudad_id") @db.Uuid
  ciudadRef Ciudad? @relation(fields: [ciudadId], references: [id], onDelete: Restrict)

  origen      OrigenCliente @default(MANUAL)
  creadoPorId String?       @map("creado_por_id") @db.Uuid
  creadoPor   Usuario?      @relation(fields: [creadoPorId], references: [id])

  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proformas Proforma[]

  @@map("clientes")
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT

  @@map("attribute_type")
}

enum AttributeVariantMode {
  /// Atributo normal: un solo valor por producto (comportamiento de siempre).
  NONE
  /// Ej: sabores de un vape. El producto puede tener 1 o más valores y no afecta el precio.
  MULTI_VALUE
  /// Ej: tamaño de un perfume. Cada valor elegido genera una variante con su propio
  /// precio de compra/utilidad/precio $ (y su propio ID de producto).
  PRICED_VARIANT

  @@map("attribute_variant_mode")
}

/// Fila única de configuración global del sistema (id fijo "default"). Por ahora solo guarda el
/// tipo de cambio $ -> Bs usado para calcular los precios en bolívares de los productos.
model SystemSetting {
  id           String   @id @default("default")
  exchangeRate Decimal  @default(0) @map("exchange_rate") @db.Decimal(12, 4)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryToParent")

  // Costos heredados por los productos de esta subcategoría (solo aplican a subcategorías, no a categorías raíz).
  logisticsCost Decimal? @map("logistics_cost") @db.Decimal(12, 2)
  shippingCost  Decimal? @map("shipping_cost") @db.Decimal(12, 2)
  securityCost  Decimal? @map("security_cost") @db.Decimal(12, 2)

  brands     BrandCategory[]
  attributes Attribute[]
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Brand {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  categories BrandCategory[]
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brands")
}

model BrandCategory {
  brandId    String   @map("brand_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([brandId, categoryId])
  @@map("brand_categories")
}

model Attribute {
  id                String               @id @default(uuid()) @db.Uuid
  categoryId        String               @map("category_id") @db.Uuid
  category          Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  type              AttributeType
  isFilterable      Boolean              @default(false) @map("is_filterable")
  isRequired        Boolean              @default(false) @map("is_required")
  // Si se muestra como columna extra en la tabla de Productos del panel (además de las de siempre).
  showInProductList Boolean              @default(false) @map("show_in_product_list")
  // Si se muestra al armar una línea de proforma (VarianteSelector/AtributosVisibles), ordenado por `orden`.
  mostrarEnProforma Boolean              @default(false) @map("mostrar_en_proforma")
  orden             Int                  @default(0)
  // Solo aplica (y solo tiene sentido) cuando type = SELECT.
  variantMode       AttributeVariantMode @default(NONE) @map("variant_mode")
  // Solo aplica cuando type = SELECT y variantMode = NONE: el producto puede elegir 1+ opciones de
  // la lista compartida de la categoría (ej. Acordes de un perfume), a diferencia de MULTI_VALUE
  // (valores propios por producto, para variantes tipo sabor).
  allowMultiple     Boolean              @default(false) @map("allow_multiple")

  options             AttributeOption[]
  productValues       ProductAttributeValue[]
  variantOptionValues ProductVariantOptionValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, name])
  @@map("attributes")
}

model AttributeOption {
  id          String    @id @default(uuid()) @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  // Color hex (ej. "#c9a96e") para el botón de esta opción en el formulario de producto. Opcional.
  color       String?

  productValues ProductAttributeValue[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([attributeId, value])
  @@map("attribute_options")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  productCode   String   @unique @map("product_code") @db.VarChar(7)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  // Utilidad cargada manualmente; ni los 3 costos heredados ni el precio final se guardan acá:
  // el precio $ se calcula en vivo como purchasePrice + costos de `category` + utility.
  utility       Decimal  @default(0) @map("utility") @db.Decimal(12, 2)
  // Precios en bolívares. Precio May Bs (mayorista) se calcula en vivo (precio $ * tipo de cambio
  // del sistema); Precio Min Bs y Descuento se cargan a mano; Precio Final Bs = (Precio Min Bs si
  // hay, si no Precio May Bs) - Descuento. Si la categoría tiene variantes con precio propio, estos
  // dos campos manuales se cargan por variante en lugar de acá (mismo criterio que purchasePrice/utility).
  minPriceBs    Decimal? @map("min_price_bs") @db.Decimal(12, 2)
  discountBs    Decimal  @default(0) @map("discount_bs") @db.Decimal(12, 2)
  brandId       String?  @map("brand_id") @db.Uuid
  brand         Brand?   @relation(fields: [brandId], references: [id])
  categoryId    String   @map("category_id") @db.Uuid
  category      Category @relation(fields: [categoryId], references: [id])
  imageUrl      String?  @map("image_url")

  attributeValues     ProductAttributeValue[]
  variantOptionValues ProductVariantOptionValue[]
  variants            ProductVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model ProductAttributeValue {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  valueText    String?          @map("value_text")
  valueNumber  Decimal?         @map("value_number") @db.Decimal(14, 4)
  valueBoolean Boolean?         @map("value_boolean")
  optionId     String?          @map("option_id") @db.Uuid
  option       AttributeOption? @relation(fields: [optionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un atributo MULTI_VALUE puede tener varias filas (una por opción elegida) para el mismo
  // producto; para atributos normales el servicio valida que solo exista una fila.
  @@unique([productId, attributeId, optionId])
  @@map("product_attribute_values")
}

/// Variante con precio propio de un producto (ej. "50ml" de un perfume): tiene su propio
/// código de producto, precio de compra y utilidad. Se define por una combinación de 1 o más
/// opciones de atributos PRICED_VARIANT de la categoría del producto.
model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantCode   String   @unique @map("variant_code") @db.VarChar(7)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  utility       Decimal  @default(0) @map("utility") @db.Decimal(12, 2)
  // Mismo criterio que en Product: Precio Min Bs y Descuento propios de esta variante.
  minPriceBs    Decimal? @map("min_price_bs") @db.Decimal(12, 2)
  discountBs    Decimal  @default(0) @map("discount_bs") @db.Decimal(12, 2)

  // Marca la única variante auto-provista para productos cuya categoría no tiene ningún atributo
  // PRICED_VARIANT (así Stock/Proformas siempre tienen un varianteId consistente al que atarse,
  // incluso para productos "simples"). Nunca se crea ni se borra a mano — la administra
  // product.service.ts (ensureDefaultVariant). Copia purchasePrice/utility/minPriceBs/discountBs del
  // Product al crearse; no se mantiene sincronizada después (el producto sigue siendo la fuente de
  // verdad para catálogo simple).
  isDefault Boolean @default(false) @map("is_default")

  options ProductVariantOption[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock            Stock[]
  lotesCompra      LoteCompra[]
  proformaDetalles ProformaDetalle[]

  @@map("product_variants")
}

/// Valor propio de un producto para un atributo MULTI_VALUE o PRICED_VARIANT (ej. "Menta" para el
/// Sabor de este vape puntual, "50 ML" para el Tamaño de este perfume puntual). A diferencia de
/// AttributeOption (compartido a nivel de categoría, solo para atributos NONE), estos valores no se
/// comparten entre productos: cada producto arma su propia lista.
model ProductVariantOptionValue {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  // Poblado solo si attribute.variantMode = PRICED_VARIANT (una variante referencia 1 de estos
  // valores por cada atributo con precio propio de la categoría).
  variantOptions ProductVariantOption[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, attributeId, value], map: "product_variant_option_values_unique")
  @@map("product_variant_option_values")
}

model ProductVariantOption {
  id            String                    @id @default(uuid()) @db.Uuid
  variantId     String                    @map("variant_id") @db.Uuid
  variant       ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String                    @map("option_value_id") @db.Uuid
  optionValue   ProductVariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@map("product_variant_options")
}

// ─────────────────────────────────────────────────────────────────────────────
// Proformas: empresas, almacenes, stock, lotes de compra y proformas de compra/venta.
// ─────────────────────────────────────────────────────────────────────────────

enum TipoEmpresa {
  CASA_MATRIZ
  SUCURSAL

  @@map("tipo_empresa")
}

enum TipoProforma {
  COMPRA
  VENTA

  @@map("tipo_proforma")
}

/// BORRADOR: recién creada, todo editable. PENDIENTE: enviada a revisión. APROBADA: motor de
/// reparto/reserva ya corrió (VENTA) o lista para completar (COMPRA). COMPLETADA: terminal, efectos
/// de stock/lotes ya aplicados. RECHAZADA/ANULADA: alcanzables desde BORRADOR, PENDIENTE o APROBADA
/// (si viene de APROBADA en una VENTA, libera las reservas hechas).
enum EstadoProforma {
  BORRADOR
  PENDIENTE
  APROBADA
  COMPLETADA
  RECHAZADA
  ANULADA

  @@map("estado_proforma")
}

/// STOCK: cubierta con inventario físico de un almacén. PROCURA: remanente sin cobertura (almacenId
/// null), a comprar/procurar aparte.
enum OrigenAsignacion {
  STOCK
  PROCURA

  @@map("origen_asignacion")
}

enum EstadoSeguimiento {
  PENDIENTE
  COMPRADO
  ENVIADO
  RECIBIDO

  @@map("estado_seguimiento")
}

model Ciudad {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  almacenes        Almacen[]
  zonasCobertura   ZonaCobertura[]
  clientes         Cliente[]
  proformasEntrega Proforma[]      @relation("ProformaCiudadEntrega")

  @@map("ciudades")
}

model Empresa {
  id          String      @id @default(uuid()) @db.Uuid
  nombre      String
  tipo        TipoEmpresa
  razonSocial String      @map("razon_social")
  nit         String      @unique
  logoUrl     String?     @map("logo_url")
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  proformas Proforma[]

  @@map("empresas")
}

model Almacen {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String
  ciudadId  String   @map("ciudad_id") @db.Uuid
  ciudad    Ciudad   @relation(fields: [ciudadId], references: [id], onDelete: Restrict)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zonasCobertura     ZonaCobertura[]
  stock              Stock[]
  lotesCompra        LoteCompra[]
  proformasRecepcion Proforma[]                  @relation("ProformaAlmacenRecepcion")
  asignaciones       ProformaDetalleAsignacion[]

  @@map("almacenes")
}

/// Prioridad de cercanía de cada almacén para una ciudad (1 = más prioritario). Se resuelve al
/// aprobar una venta para decidir de qué almacén(es) se reparte el stock.
model ZonaCobertura {
  ciudadId  String  @map("ciudad_id") @db.Uuid
  ciudad    Ciudad  @relation(fields: [ciudadId], references: [id], onDelete: Cascade)
  almacenId String  @map("almacen_id") @db.Uuid
  almacen   Almacen @relation(fields: [almacenId], references: [id], onDelete: Cascade)
  prioridad Int

  createdAt DateTime @default(now()) @map("created_at")

  @@id([ciudadId, almacenId])
  @@unique([ciudadId, prioridad])
  @@map("zonas_cobertura")
}

/// Existencias por variante y almacén. cantidadReservada se incrementa al aprobar una venta (aparta
/// stock sin descontarlo todavía) y se descuenta junto con cantidadFisica al completarla.
/// CHECK agregado a mano en la migración: cantidad_fisica >= 0 AND cantidad_reservada >= 0 AND
/// cantidad_reservada <= cantidad_fisica (Prisma no expresa CHECK en el schema).
model Stock {
  varianteId        String         @map("variante_id") @db.Uuid
  variante          ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  almacenId         String         @map("almacen_id") @db.Uuid
  almacen           Almacen        @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  cantidadFisica    Int            @default(0) @map("cantidad_fisica")
  cantidadReservada Int            @default(0) @map("cantidad_reservada")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@id([varianteId, almacenId])
  @@map("stock")
}

/// Un lote por línea de compra completada, con el costo real de esa compra puntual. Nunca se borra
/// ni se modifica al cambiar el catálogo — es el registro histórico que se consume con FIFO al
/// vender, y lo que permite calcular margen real más adelante.
model LoteCompra {
  id                 String          @id @default(uuid()) @db.Uuid
  varianteId         String          @map("variante_id") @db.Uuid
  variante           ProductVariant  @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  almacenId          String          @map("almacen_id") @db.Uuid
  almacen            Almacen         @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  proformaDetalleId  String          @unique @map("proforma_detalle_id") @db.Uuid
  proformaDetalle    ProformaDetalle @relation(fields: [proformaDetalleId], references: [id], onDelete: Restrict)
  costoUnitario      Decimal         @map("costo_unitario") @db.Decimal(12, 2)
  cantidadInicial    Int             @map("cantidad_inicial")
  cantidadDisponible Int             @map("cantidad_disponible")
  fecha              DateTime        @default(now())

  consumos LoteCompraConsumo[]

  @@index([varianteId, almacenId, fecha])
  @@map("lotes_compra")
}

/// Registra de qué lote(s) salió cada unidad vendida (consumo FIFO al completar una venta) — la
/// tabla que hace posible calcular margen real más adelante. No está nombrada en el spec original,
/// pero es necesaria para cumplir "registrando de qué lote(s) salió cada unidad vendida".
model LoteCompraConsumo {
  id                          String                    @id @default(uuid()) @db.Uuid
  loteCompraId                String                    @map("lote_compra_id") @db.Uuid
  loteCompra                  LoteCompra                @relation(fields: [loteCompraId], references: [id], onDelete: Restrict)
  proformaDetalleAsignacionId String                    @map("proforma_detalle_asignacion_id") @db.Uuid
  asignacion                  ProformaDetalleAsignacion @relation(fields: [proformaDetalleAsignacionId], references: [id], onDelete: Restrict)
  cantidad                    Int
  createdAt                   DateTime                  @default(now()) @map("created_at")

  @@unique([loteCompraId, proformaDetalleAsignacionId])
  @@map("lotes_compra_consumo")
}

model Proforma {
  id     String         @id @default(uuid()) @db.Uuid
  tipo   TipoProforma
  estado EstadoProforma @default(BORRADOR)

  empresaId String  @map("empresa_id") @db.Uuid
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  // Obligatorio si tipo = VENTA, null si tipo = COMPRA (validado en servicio).
  clienteId String?  @map("cliente_id") @db.Uuid
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  // Solo COMPRA: a qué almacén entra la mercadería. No estaba en el spec original — hueco real que
  // había que resolver, ya que LoteCompra exige almacenId y nada más en el flujo de compra lo provee.
  almacenRecepcionId String?  @map("almacen_recepcion_id") @db.Uuid
  almacenRecepcion   Almacen? @relation("ProformaAlmacenRecepcion", fields: [almacenRecepcionId], references: [id], onDelete: Restrict)

  // Solo VENTA: determina el orden de cercanía de almacenes vía ZonaCobertura al aprobar.
  ciudadEntregaId String? @map("ciudad_entrega_id") @db.Uuid
  ciudadEntrega   Ciudad? @relation("ProformaCiudadEntrega", fields: [ciudadEntregaId], references: [id], onDelete: Restrict)

  creadoPorId String  @map("creado_por_id") @db.Uuid
  creadoPor   Usuario @relation("ProformaCreadaPor", fields: [creadoPorId], references: [id])

  // Aplica sobre el total del documento, no por línea (no se mezcla con el descuento de catálogo,
  // que ya está incorporado en precioFinalBs de cada línea de venta).
  descuentoGeneral Decimal  @default(0) @map("descuento_general") @db.Decimal(12, 2)
  // Campo informativo por ahora: qué % del total debe adelantar el cliente (el monto y el saldo se
  // calculan en vivo a partir del total de las líneas). Sin ligar a un módulo de pagos todavía
  // (punto de extensión futuro).
  adelantoPorcentaje Decimal? @map("adelanto_porcentaje") @db.Decimal(5, 2)

  fecha     DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  detalles  ProformaDetalle[]
  historial ProformaHistorial[]

  @@index([tipo, estado])
  @@map("proformas")
}

model ProformaDetalle {
  id         String         @id @default(uuid()) @db.Uuid
  proformaId String         @map("proforma_id") @db.Uuid
  proforma   Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  varianteId String         @map("variante_id") @db.Uuid
  variante   ProductVariant @relation(fields: [varianteId], references: [id], onDelete: Restrict)
  cantidad   Int

  // VENTA: nace de ProductVariant.precioFinalBs (calculado en vivo al agregar la línea) y es editable
  // después.
  precioUnitario Decimal? @map("precio_unitario") @db.Decimal(12, 2)

  // COMPRA: capturados por línea (no heredados del catálogo) — de esta compra puntual. Al completar
  // se usan para armar el LoteCompra; el catálogo (Product/ProductVariant) nunca se sobreescribe con
  // estos valores.
  precioCompra   Decimal? @map("precio_compra") @db.Decimal(12, 2)
  costoEnvio     Decimal? @map("costo_envio") @db.Decimal(12, 2)
  costoSeguridad Decimal? @map("costo_seguridad") @db.Decimal(12, 2)
  costoLogistica Decimal? @map("costo_logistica") @db.Decimal(12, 2)

  // cantidad × precioUnitario (VENTA) o cantidad × suma de los 4 costos (COMPRA). Recalculado en el
  // servicio en cada create/update de la línea.
  subtotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  asignaciones ProformaDetalleAsignacion[]
  loteCompra   LoteCompra?
  seguimientos ProformaDetalleSeguimiento[]

  @@map("proforma_detalles")
}

/// Reparto de una línea de venta entre almacenes (armado al aprobar). CHECK agregado a mano en la
/// migración: (origen='PROCURA' AND almacen_id IS NULL) OR (origen='STOCK' AND almacen_id IS NOT NULL).
model ProformaDetalleAsignacion {
  id                String           @id @default(uuid()) @db.Uuid
  proformaDetalleId String           @map("proforma_detalle_id") @db.Uuid
  proformaDetalle   ProformaDetalle  @relation(fields: [proformaDetalleId], references: [id], onDelete: Cascade)
  almacenId         String?          @map("almacen_id") @db.Uuid
  almacen           Almacen?         @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  cantidad          Int
  origen            OrigenAsignacion

  createdAt DateTime @default(now()) @map("created_at")

  consumos LoteCompraConsumo[]

  @@map("proforma_detalle_asignaciones")
}

/// Log de solo-inserción de cada cambio de estado de una proforma.
model ProformaHistorial {
  id         String         @id @default(uuid()) @db.Uuid
  proformaId String         @map("proforma_id") @db.Uuid
  proforma   Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  estado     EstadoProforma
  fecha      DateTime       @default(now())
  usuarioId  String         @map("usuario_id") @db.Uuid
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  nota       String?

  @@map("proforma_historial")
}

/// Seguimiento interno por línea (envío/recepción), separado del flujo de aprobación — nunca toca
/// Stock ni el estado de la Proforma. Log de solo-inserción atado a la línea (ProformaDetalle), igual
/// patrón que ProformaHistorial: el estado "actual" es la fila más reciente por fecha.
model ProformaDetalleSeguimiento {
  id                String            @id @default(uuid()) @db.Uuid
  proformaDetalleId String            @map("proforma_detalle_id") @db.Uuid
  proformaDetalle   ProformaDetalle   @relation(fields: [proformaDetalleId], references: [id], onDelete: Cascade)
  estado            EstadoSeguimiento
  fecha             DateTime          @default(now())
  usuarioId         String            @map("usuario_id") @db.Uuid
  usuario           Usuario           @relation(fields: [usuarioId], references: [id])
  nota              String?

  @@map("proforma_detalle_seguimiento")
}
