generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  USER
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @default("") @map("first_name")
  lastName     String   @default("") @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  roleId       String   @map("role_id") @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT

  @@map("attribute_type")
}

enum AttributeVariantMode {
  /// Atributo normal: un solo valor por producto (comportamiento de siempre).
  NONE
  /// Ej: sabores de un vape. El producto puede tener 1 o más valores y no afecta el precio.
  MULTI_VALUE
  /// Ej: tamaño de un perfume. Cada valor elegido genera una variante con su propio
  /// precio de compra/utilidad/precio $ (y su propio ID de producto).
  PRICED_VARIANT

  @@map("attribute_variant_mode")
}

/// Fila única de configuración global del sistema (id fijo "default"). Por ahora solo guarda el
/// tipo de cambio $ -> Bs usado para calcular los precios en bolívares de los productos.
model SystemSetting {
  id           String   @id @default("default")
  exchangeRate Decimal  @default(0) @map("exchange_rate") @db.Decimal(12, 4)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  parentId  String?    @map("parent_id") @db.Uuid
  parent    Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryToParent")

  // Costos heredados por los productos de esta subcategoría (solo aplican a subcategorías, no a categorías raíz).
  logisticsCost Decimal? @map("logistics_cost") @db.Decimal(12, 2)
  shippingCost  Decimal? @map("shipping_cost") @db.Decimal(12, 2)
  securityCost  Decimal? @map("security_cost") @db.Decimal(12, 2)

  brands     BrandCategory[]
  attributes Attribute[]
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Brand {
  id   String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique

  categories BrandCategory[]
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brands")
}

model BrandCategory {
  brandId    String   @map("brand_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([brandId, categoryId])
  @@map("brand_categories")
}

model Attribute {
  id           String        @id @default(uuid()) @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  type         AttributeType
  isFilterable Boolean       @default(false) @map("is_filterable")
  isRequired   Boolean       @default(false) @map("is_required")
  // Si se muestra como columna extra en la tabla de Productos del panel (además de las de siempre).
  showInProductList Boolean  @default(false) @map("show_in_product_list")
  // Solo aplica (y solo tiene sentido) cuando type = SELECT.
  variantMode  AttributeVariantMode @default(NONE) @map("variant_mode")
  // Solo aplica cuando type = SELECT y variantMode = NONE: el producto puede elegir 1+ opciones de
  // la lista compartida de la categoría (ej. Acordes de un perfume), a diferencia de MULTI_VALUE
  // (valores propios por producto, para variantes tipo sabor).
  allowMultiple Boolean @default(false) @map("allow_multiple")

  options             AttributeOption[]
  productValues       ProductAttributeValue[]
  variantOptionValues ProductVariantOptionValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, name])
  @@map("attributes")
}

model AttributeOption {
  id          String    @id @default(uuid()) @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  // Color hex (ej. "#c9a96e") para el botón de esta opción en el formulario de producto. Opcional.
  color       String?

  productValues ProductAttributeValue[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([attributeId, value])
  @@map("attribute_options")
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  productCode   String   @unique @map("product_code") @db.VarChar(7)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  // Utilidad cargada manualmente; ni los 3 costos heredados ni el precio final se guardan acá:
  // el precio $ se calcula en vivo como purchasePrice + costos de `category` + utility.
  utility       Decimal  @default(0) @map("utility") @db.Decimal(12, 2)
  // Precios en bolívares. Precio May Bs (mayorista) se calcula en vivo (precio $ * tipo de cambio
  // del sistema); Precio Min Bs y Descuento se cargan a mano; Precio Final Bs = (Precio Min Bs si
  // hay, si no Precio May Bs) - Descuento. Si la categoría tiene variantes con precio propio, estos
  // dos campos manuales se cargan por variante en lugar de acá (mismo criterio que purchasePrice/utility).
  minPriceBs    Decimal? @map("min_price_bs") @db.Decimal(12, 2)
  discountBs    Decimal  @default(0) @map("discount_bs") @db.Decimal(12, 2)
  brandId       String?  @map("brand_id") @db.Uuid
  brand         Brand?   @relation(fields: [brandId], references: [id])
  categoryId    String   @map("category_id") @db.Uuid
  category      Category @relation(fields: [categoryId], references: [id])
  imageUrl      String?  @map("image_url")

  attributeValues     ProductAttributeValue[]
  variantOptionValues ProductVariantOptionValue[]
  variants            ProductVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model ProductAttributeValue {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  valueText    String?  @map("value_text")
  valueNumber  Decimal? @map("value_number") @db.Decimal(14, 4)
  valueBoolean Boolean? @map("value_boolean")
  optionId     String?  @map("option_id") @db.Uuid
  option       AttributeOption? @relation(fields: [optionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un atributo MULTI_VALUE puede tener varias filas (una por opción elegida) para el mismo
  // producto; para atributos normales el servicio valida que solo exista una fila.
  @@unique([productId, attributeId, optionId])
  @@map("product_attribute_values")
}

/// Variante con precio propio de un producto (ej. "50ml" de un perfume): tiene su propio
/// código de producto, precio de compra y utilidad. Se define por una combinación de 1 o más
/// opciones de atributos PRICED_VARIANT de la categoría del producto.
model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantCode   String   @unique @map("variant_code") @db.VarChar(7)
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  utility       Decimal  @default(0) @map("utility") @db.Decimal(12, 2)
  // Mismo criterio que en Product: Precio Min Bs y Descuento propios de esta variante.
  minPriceBs    Decimal? @map("min_price_bs") @db.Decimal(12, 2)
  discountBs    Decimal  @default(0) @map("discount_bs") @db.Decimal(12, 2)

  options ProductVariantOption[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_variants")
}

/// Valor propio de un producto para un atributo MULTI_VALUE o PRICED_VARIANT (ej. "Menta" para el
/// Sabor de este vape puntual, "50 ML" para el Tamaño de este perfume puntual). A diferencia de
/// AttributeOption (compartido a nivel de categoría, solo para atributos NONE), estos valores no se
/// comparten entre productos: cada producto arma su propia lista.
model ProductVariantOptionValue {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String    @map("attribute_id") @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  // Poblado solo si attribute.variantMode = PRICED_VARIANT (una variante referencia 1 de estos
  // valores por cada atributo con precio propio de la categoría).
  variantOptions ProductVariantOption[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, attributeId, value], map: "product_variant_option_values_unique")
  @@map("product_variant_option_values")
}

model ProductVariantOption {
  id            String                    @id @default(uuid()) @db.Uuid
  variantId     String                    @map("variant_id") @db.Uuid
  variant       ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String                    @map("option_value_id") @db.Uuid
  optionValue   ProductVariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@map("product_variant_options")
}
