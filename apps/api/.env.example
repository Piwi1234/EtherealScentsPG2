DATABASE_URL="postgresql://user:password@localhost:5432/nuevo_proyecto?schema=public"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Auth de clientes (sitio público) — secretos separados de los de gestión a propósito.
CLIENTE_JWT_ACCESS_SECRET="change-me-cliente-access"
CLIENTE_JWT_REFRESH_SECRET="change-me-cliente-refresh"
CLIENTE_JWT_ACCESS_EXPIRES_IN="30m"
CLIENTE_JWT_REFRESH_EXPIRES_IN="7d"

# "Continuar con Google" — crear en Google Cloud Console (APIs & Services > Credentials > OAuth
# client ID > Web application). Redirect URI a registrar ahí: GOOGLE_CALLBACK_URL de acá abajo,
# byte a byte (incluido el prefijo /api de setGlobalPrefix).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4100/api/cliente-auth/google/callback"

WEB_ORIGIN="http://localhost:3100"
PORT=4100

# Carpeta base de uploads (imágenes de productos, marcas, carrusel, etc). En local no hace falta
# tocarla (cae a process.cwd()/uploads). En producción, poner el path absoluto donde está montado
# el volumen persistente — si no, las imágenes subidas se pierden en cada deploy.
# UPLOADS_DIR="/data/uploads"
