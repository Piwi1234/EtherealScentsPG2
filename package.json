{
  "name": "nuevo-proyecto",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @app/database db:generate",
    "db:migrate": "pnpm --filter @app/database db:migrate",
    "db:seed": "pnpm --filter @app/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  }
}
